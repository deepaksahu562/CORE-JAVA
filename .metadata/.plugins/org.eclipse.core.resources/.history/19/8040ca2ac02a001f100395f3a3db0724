class Hello1199{
	int show(){
		int a = 0;
		try {
			System.out.println("Try block befins :"+a);
			a = 10 / 4;
			System.out.println("Try block end :"+a);
			System.exit(0);
			return a;
		}catch (Exception e) {
			a = 20;
			System.out.println("Catch block :"+a);
			//System.exit(0);
			return a;
		} finally {
			a = 30;
			System.out.println("Finally block :"+a);
			//return a;
			//int arr[] = new int[-1];
		}
	}
}